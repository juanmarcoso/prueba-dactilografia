# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO debe subirse al repositorio (ver .gitignore).

# Clave secreta de Django. Usa una cadena aleatoria larga en producción.
DJANGO_SECRET_KEY=django-insecure-d1ucc=qsq$ur1r^f9+xl(_eonyj_@(@uqb(wzn5)*d%*n32w6a

# true en desarrollo; 0 o false para producción (desactiva el modo debug).
